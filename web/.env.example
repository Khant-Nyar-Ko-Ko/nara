# Copy to .env.local and fill in. Never commit .env.local (already gitignored).

# App runtime credential: the restricted `nara_app` role from web/sql/001_app_role.sql
# (INSERT/SELECT only on access_log). Pooler username is `nara_app.<project-ref>`.
# Must be the Supabase Postgres connection string (Transaction pooler) — /api/digest
# reads the crawler's `news` table from the same database. Don't append
# ?sslmode=... — node-postgres lets it override the TLS settings in lib/db.ts.
DATABASE_URL=

# Supabase's CA certificate (PEM), so TLS verification passes. Download it from
# Supabase → Project Settings → Database → SSL Configuration. Paste the whole
# file in double quotes (multi-line is fine), or as one line with \n escapes.
# Public, not a secret — but keep it here rather than hard-coding it.
DATABASE_CA_CERT=

# Elevated credential for the scheduled retention job only (lib/db.ts
# runRetentionJob) — never used by request-handling code. This is the `postgres`
# pooler string; it's also the login for running ensureSchema() and web/sql/*.sql.
RETENTION_DATABASE_URL=

# Resend API key + verified "from" address for the F3 digest email
# (web/app/api/dispatch/email/route.ts).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# HMAC key signing the session cookie (lib/auth.ts). Long, random, secret —
# rotating it invalidates every existing session.
SESSION_SECRET=
