# Copy to .env.local and fill in. Never commit .env.local (already gitignored).

# App runtime credential. Role should have INSERT/SELECT only on access_log.
DATABASE_URL=

# Elevated credential for the scheduled retention job only (lib/db.ts
# runRetentionJob) — never used by request-handling code.
RETENTION_DATABASE_URL=

EMAIL_PROVIDER_API_KEY=
