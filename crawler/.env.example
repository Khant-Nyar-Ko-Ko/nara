APIFY_TOKEN=your_apify_api_token_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Supabase backend credentials for inserting crawled news.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_NEWS_TABLE=news

# Actor used by the manual news crawl. This returns posts from Facebook pages/profiles.
APIFY_FACEBOOK_POSTS_ACTOR_ID=apify/facebook-posts-scraper

# Actor used if you want page profile info such as followers, intro, website.
APIFY_FACEBOOK_PAGES_ACTOR_ID=apify/facebook-pages-scraper

# Keep manual crawl intentionally small: one latest post per source.
APIFY_FACEBOOK_RESULTS_LIMIT=1
